# Variáveis lidas pelo docker-compose.yml:   cp .env.example .env
# Os valores abaixo já funcionam para desenvolvimento local.

# Usuário/senha root do MongoDB (apenas para desenvolvimento). Ao trocar,
# use só letras e números na senha (ela entra na connection string da API).
MONGO_INITDB_ROOT_USERNAME=employees
MONGO_INITDB_ROOT_PASSWORD=employees123

# Portas expostas no host
MONGO_PORT=27017
API_PORT=3333
WEB_PORT=3000
