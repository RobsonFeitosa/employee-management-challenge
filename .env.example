# Variáveis lidas pelo docker-compose.yml. NÃO commitar o .env real.
#   cp .env.example .env   e preencha com valores próprios.

# Usuário/senha root do MongoDB. Use só letras e números na senha
# (ela entra na connection string da API).
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=

# Portas expostas no host
MONGO_PORT=27017
API_PORT=3333
WEB_PORT=3000
